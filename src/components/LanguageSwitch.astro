---
import { UI_COPY, type Locale } from "@/config";

interface Props {
  locale: Locale;
  href: string;
}

const { locale, href } = Astro.props;
const copy = UI_COPY[locale];
---

<a
  class="language-switch"
  href={href}
  data-astro-prefetch
  aria-label={copy.languageSwitchTitle}
  title={copy.languageSwitchTitle}
>
  {copy.languageSwitchLabel}
</a>

<style>
  .language-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    border: 1.5px solid var(--theme-text);
    color: var(--theme-text);
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    line-height: 1;
  }

  .language-switch:hover,
  .language-switch:focus {
    color: #fff;
    background-color: var(--theme-accent);
    border-color: var(--theme-accent);
  }
</style>
