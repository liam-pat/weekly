---
import { SITE_I18N, type Locale } from "@/config";
import AstroLogo from "./Header/AstroLogo.astro";

interface Props {
  locale?: Locale;
  class?: string;
}

const { locale = "zh", class: className } = Astro.props;
const site = SITE_I18N[locale];
---

<div class:list={["site-logo", className]}>
  <a href={site.homePath} class="logo-image" data-astro-prefetch>
    <AstroLogo size={40} />
  </a>
  <a href={site.homePath} data-astro-prefetch>
    <h1 class="text-gray-800 dark:text-gray-200">{site.title}</h1>
  </a>
  <slot />
</div>

<style>
  .site-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 0.25em;
    font-size: 2rem;
    font-weight: 600;
    line-height: 1;
  }

  .site-logo a {
    display: block;
    margin: -0.5em -0.25em;
    padding: 0.5em 0.25em;
    color: var(--theme-text);
    font-weight: bold;
    text-decoration: none;
    transition: color 100ms ease-out;
  }

  .site-logo a:hover,
  .site-logo a:focus {
    color: var(--theme-accent);
  }

  .site-logo .logo-image {
    margin-top: -0.6em;
  }

  h1 {
    margin: 0;
    font: inherit;
  }

  .site-logo :global(.language-switch) {
    margin-left: auto;
  }
</style>
