---
import { getPostNumber, parseTitle } from "@/util";
import type { Locale } from "@/config";

interface Props {
  post: any;
  locale: Locale;
  priority?: boolean;
}

const { post, locale, priority = false } = Astro.props;
const title = parseTitle(post.file);
const { pic, desc, date } = post.frontmatter;
const postNumber = getPostNumber(post);
const postHref = `${locale === "en" ? "/en" : ""}/posts/${postNumber}/`;
---

<a
  href={postHref}
  data-astro-prefetch
  class="card-content mx-auto mt-4 flex w-full max-w-96 flex-col overflow-hidden rounded-b-md pb-3 shadow-md md:mr-5 md:mt-5 md:w-80"
>
  <img
    src={pic}
    alt={title}
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : undefined}
    decoding="async"
    class="block h-52 w-full rounded-t-md object-cover md:h-48 md:w-80"
  />
  <div
    class="flex w-full items-center justify-between pl-3 pr-3 pt-4 leading-tight"
  >
    <div class="text-gray-800 dark:text-gray-200">{title}</div>
    <div class="silver-date text-sm font-extrabold tracking-wide">{date}</div>
  </div>
  <p
    class="line-clamp-2 h-12 w-full overflow-hidden px-3 pt-2.5 text-sm text-gray-600 dark:text-gray-300"
  >
    {desc}
  </p>
</a>

<style>
  .silver-date {
    position: relative;
    display: inline-block;
    font-weight: 700;
    /* 白天模式：深色高级金属钛银，对比度高、字迹清晰锐利 */
    background: linear-gradient(
      135deg,
      #334155 0%,
      #64748b 40%,
      #475569 70%,
      #1e293b 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    overflow: hidden;
  }

  /* 夜间模式：亮白金金属银 */
  :global(body.dark) .silver-date,
  :global([data-theme="dark"]) .silver-date {
    background: linear-gradient(
      135deg,
      #f8fafc 0%,
      #cbd5e1 35%,
      #94a3b8 70%,
      #64748b 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Shimmer sweep — GPU transform, only on hover */
  .silver-date::after {
    content: "";
    position: absolute;
    inset: -2px -20px;
    background: linear-gradient(
      105deg,
      transparent 30%,
      rgba(255, 255, 255, 0.7) 45%,
      rgba(255, 255, 255, 0.95) 50%,
      rgba(255, 255, 255, 0.7) 55%,
      transparent 70%
    );
    transform: translateX(-120%);
    transition: none;
    pointer-events: none;
  }

  .card-content:hover .silver-date::after {
    animation: shimmerSweep 0.8s ease-out forwards;
  }

  @keyframes shimmerSweep {
    to {
      transform: translateX(120%);
    }
  }
</style>
