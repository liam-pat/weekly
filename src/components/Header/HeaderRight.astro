---
import { SITE, SITE_I18N, type Locale } from "@/config";
import HeaderLink from "./HeaderLink.astro";
import Search from "./Search.astro";
import LanguageSwitch from "../LanguageSwitch.astro";

const { blogPage } = SITE;

interface Props {
  locale?: Locale;
}

const { locale = "zh" } = Astro.props;
const alternateUrl = SITE_I18N[locale === "zh" ? "en" : "zh"].homePath;
---

<div class="flex-grow text-right md:mr-1 -mr-1">
  <Search locale={locale} />
  <span class="ml-3 inline-flex items-center md:ml-4">
    <LanguageSwitch locale={locale} href={alternateUrl} />
  </span>
  <HeaderLink href={blogPage} target="_blank">Blog</HeaderLink>
  <HeaderLink
    href={locale === "en" ? "/en/rss.xml" : "/rss.xml"}
    target="_blank"
    class="lg:inline-block hidden">RSS</HeaderLink
  >
</div>
