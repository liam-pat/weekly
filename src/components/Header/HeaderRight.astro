---
import { SITE, SITE_I18N, type Locale } from "@/config";
import HeaderLink from "./HeaderLink.astro";
import Search from "./Search.astro";
import LanguageSwitch from "../LanguageSwitch.astro";

const { blogPage } = SITE;

interface Props {
  locale?: Locale;
}

const { locale = "zh" } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const isPostPage =
  locale === "zh"
    ? currentPath.startsWith("/posts/")
    : currentPath.startsWith("/en/posts/");
const alternateUrl = isPostPage
  ? locale === "zh"
    ? `/en${currentPath}`
    : currentPath.replace(/^\/en/, "")
  : SITE_I18N[locale === "zh" ? "en" : "zh"].homePath;
---

<div class="flex-grow text-right md:mr-1 -mr-1">
  <Search locale={locale} />
  <LanguageSwitch locale={locale} href={alternateUrl} />
  <HeaderLink href={blogPage} target="_blank">Blog</HeaderLink>
  <HeaderLink
    href={locale === "en" ? "/en/rss.xml" : "/rss.xml"}
    target="_blank"
    class="lg:inline-block hidden">RSS</HeaderLink
  >
</div>
