---
import LanguageSwitch from "./LanguageSwitch.astro";
import SiteLogo from "./SiteLogo.astro";
import type { Locale } from "@/config";
import { getPostNumber, parseTitle, sortPosts } from "@/util";

interface Props {
  currentPage: string;
  locale?: Locale;
  alternateUrl?: string;
}

const {
  currentPage,
  locale = "zh",
  alternateUrl = locale === "zh" ? "/en/" : "/",
} = Astro.props;
const zhPosts = Object.values(
  import.meta.glob("../pages/posts/*.md", { eager: true }),
);
const enPosts = Object.values(
  import.meta.glob("../pages/en/posts/*.md", { eager: true }),
);
const allPosts = sortPosts(locale === "zh" ? zhPosts : enPosts);
const currentPageMatch = currentPage
  .replace(/^\/en(?=\/|$)/, "")
  .slice(1)
  .replace(/\/$/, "");
const postPathPrefix = locale === "en" ? "/en" : "";

const routes = allPosts.map((post) => ({
  title: parseTitle(post.file),
  link: `posts/${getPostNumber(post)}`,
}));
---

<nav aria-labelledby="grid-left" class="pt-6 text-gray-800 dark:text-gray-200">
  <SiteLogo locale={locale} class="sidebar-logo">
    <LanguageSwitch locale={locale} href={alternateUrl} />
  </SiteLogo>
  <ul class="nav-groups">
    {
      routes.length ? (
        routes.map((route) => (
          <li class="nav-link">
            <a
              data-astro-prefetch
              href={`${postPathPrefix}/${route.link}/`}
              aria-current={
                decodeURIComponent(currentPageMatch) === route.link
                  ? "page"
                  : undefined
              }
            >
              {route.title}
            </a>
          </li>
        ))
      ) : (
        <li class="empty-state">
          {locale === "en" ? "English issues are coming soon." : ""}
        </li>
      )
    }
  </ul>
</nav>

<script is:inline>
  const navGroups = document.querySelector(".nav-groups");

  if (navGroups) {
    const savedScrollPosition = localStorage.getItem("sidebarScrollPosition");
    if (savedScrollPosition !== null) {
      navGroups.scrollTop = parseInt(savedScrollPosition, 10);
    } else {
      const target = document.querySelector('[aria-current="page"]');
      if (target && target.offsetTop > window.innerHeight - 100) {
        navGroups.scrollTop = target.offsetTop - 86;
      }
    }

    navGroups.style.visibility = "visible";

    localStorage.removeItem("sidebarScrollPosition");

    navGroups.addEventListener("click", (event) => {
      const link = event.target.closest("a");
      if (link) {
        const scrollPosition = navGroups.scrollTop;
        localStorage.setItem("sidebarScrollPosition", scrollPosition);
      }
    });
  }
</script>

<style>
  nav {
    width: 100%;
    margin-right: 1rem;
  }
  .nav-groups {
    height: 100%;
    padding: 2rem 0;
    overflow-x: visible;
    overflow-y: auto;
    max-height: 100vh;
    visibility: hidden;
  }

  .nav-groups > :first-child {
    padding-top: 0;
  }

  .nav-groups > :last-child {
    padding-bottom: 2rem;
    margin-bottom: var(--theme-navbar-height);
  }

  .nav-link a {
    font-size: 1.08rem;
    margin: 1px;
    padding: 0.3rem 0.7rem;
    color: inherit;
    text-decoration: none;
    display: block;
  }
  .nav-link a:hover,
  .nav-link a:focus {
    color: var(--theme-accent);
  }

  .nav-link a[aria-current="page"] {
    color: var(--theme-accent);
    font-weight: bolder;
  }

  @media (min-width: 50em) {
    .nav-groups {
      padding: 0;
      margin-top: 0.7em;
    }
  }
  :global(.sidebar-logo) {
    overflow: hidden;
    padding: 0.25em 0;
  }

  .empty-state {
    color: var(--theme-text-secondary, var(--theme-text));
    font-size: 0.95rem;
    line-height: 1.5;
    padding: 1rem 0.7rem;
  }
</style>
