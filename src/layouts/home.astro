---
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import HeadCommon from "@/components/HeadCommon.astro";
import HeadSEO from "@/components/HeadSEO.astro";
import Header from "@/components/Header/Header.astro";
import { SITE, SITE_I18N, type Locale } from "@/config";
import { sortPosts } from "@/util";

interface Props {
  locale: Locale;
  posts: any[];
}

const { locale, posts } = Astro.props;
const site = SITE_I18N[locale];
const allPosts = sortPosts(posts);
const pageURL = locale === "en" ? `${SITE.homePage}/en/` : SITE.homePage;
---

<html lang={site.htmlLang}>
  <head>
    <HeadCommon />
    <HeadSEO
      pageURL={pageURL}
      content={{}}
      locale={locale}
      alternates={{ zh: SITE.homePage, en: `${SITE.homePage}/en/` }}
    />
    <title>{site.title}</title>
  </head>

  <body data-pagefind-ignore>
    <Header locale={locale} />
    {
      allPosts.length ? (
        <main class="mx-auto -mt-5 mb-12 box-border w-full max-w-xl px-3 md:max-w-2xl md:px-0 lg:max-w-5xl xl:max-w-7xl">
          <div class="grid md:-mr-5 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {allPosts.map((post, index) => (
              <Card post={post} locale={locale} priority={index === 0} />
            ))}
          </div>
        </main>
      ) : locale === "en" ? (
        <main class="mx-auto mb-12 mt-8 w-full max-w-xl px-5 md:mt-14">
          <section class="rounded-md border border-stone-200 bg-white p-8 text-center shadow-sm dark:border-stone-700 dark:bg-stone-900">
            <h2 class="text-2xl font-semibold text-gray-800 dark:text-gray-100">
              The English edition is coming soon.
            </h2>
            <p class="mt-4 leading-7 text-gray-600 dark:text-gray-300">
              We are translating the archive. In the meantime, you can browse
              the original Chinese edition.
            </p>
            <a
              href="/"
              data-astro-prefetch
              class="mt-6 inline-block font-semibold text-[var(--theme-accent)] no-underline hover:underline"
            >
              Browse the Chinese edition
            </a>
          </section>
        </main>
      ) : null
    }
    <Footer />
  </body>
</html>
