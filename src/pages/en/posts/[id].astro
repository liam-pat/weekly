---
import PostLayout from "../../../layouts/post.astro";
import { SITE } from "@/config";
import { getPostNumber, getTitlePart, sortPosts } from "@/util";

export async function getStaticPaths() {
  const zhPosts = sortPosts(
    Object.values(import.meta.glob("../../posts/*.md", { eager: true })),
  );
  const enPosts = Object.values(
    import.meta.glob("./*.md", { eager: true }),
  );
  const enMap = new Map<number, any>();
  for (const enPost of enPosts) {
    enMap.set(getPostNumber(enPost), enPost);
  }

  return zhPosts.map((zhPost: any) => {
    const id = getPostNumber(zhPost);
    const enPost = enMap.get(id);
    return {
      params: { id: String(id) },
      props: {
        id,
        hasTranslation: Boolean(enPost),
        enPost,
        date: enPost?.frontmatter?.date || zhPost.frontmatter.date,
        zhTitleText: getTitlePart(zhPost.file),
      },
    };
  });
}

const { id, hasTranslation, enPost, date, zhTitleText } = Astro.props;
const chineseUrl = `/posts/${id}`;

let Content: any = null;
let frontmatter: any = null;

if (hasTranslation && enPost) {
  Content = enPost.Content;
  const enTitleText = getTitlePart(enPost.file) || zhTitleText;
  frontmatter = {
    ...enPost.frontmatter,
    date,
    url: `/en/posts/${id}`,
    headerTitle: `${id} - ${enTitleText}`,
    locale: "en",
  };
} else {
  frontmatter = {
    date,
    pic: SITE.pic,
    desc: "The English translation of this issue is coming soon.",
    url: `/en/posts/${id}`,
    headerTitle: `Issue ${id}`,
    locale: "en",
  };
}
---

{
  hasTranslation && Content ? (
    <Content frontmatter={frontmatter} />
  ) : (
    <PostLayout
      frontmatter={frontmatter}
      locale="en"
      alternateUrl={chineseUrl}
    >
      <section
        class="translation-pending"
        aria-label="English translation status"
      >
        <p>The English version of this issue is coming soon.</p>
        <a href={chineseUrl} data-astro-prefetch>
          Read the Chinese original
        </a>
      </section>
    </PostLayout>
  )
}

<style>
  .translation-pending {
    border: 1px solid color-mix(in srgb, var(--theme-accent) 30%, transparent);
    border-radius: 0.5rem;
    margin: 1.5rem 0;
    padding: 1.25rem 1.5rem;
  }

  .translation-pending p {
    margin: 0 0 0.75rem;
  }

  .translation-pending a {
    color: var(--theme-accent);
  }
</style>
